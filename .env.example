# Copia este archivo como .env y rellena los valores. NUNCA subas .env a git.

# Para que el comando "flask" encuentre la app
FLASK_APP=app
FLASK_RUN_PORT=5050
FLASK_DEBUG=1
APP_CONFIG=desarrollo

# Clave de sesión: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Desarrollo: SQLite (archivo en instance/niebla.db, no hay que instalar nada)
# Producción: postgresql://usuario:contraseña@servidor:5432/nombre_bd
DATABASE_URL=sqlite:///niebla.db

# Clave de cifrado del diario y datos de salud:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ Haz copia de seguridad. Si se pierde, los datos cifrados no se recuperan.
CLAVE_CIFRADO_DATOS=

# Google Calendar (opcional). Cómo conseguirlas: docs/google-calendar.md
# Sin ellas la app funciona igual, solo que sin sincronizar con Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recetas con IA (opcional). Clave de https://platform.claude.com (de pago por uso).
# Sin ella, la pestaña de recetas explica cómo activarla.
ANTHROPIC_API_KEY=
RECETAS_IA_AL_DIA=10
